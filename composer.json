{
    "name": "alveby/atrium-theme",
    "description": "Neutral public site theme for Atrium that renders any module",
    "type": "library",
    "license": "MIT",
    "homepage": "https://github.com/AlveBy/atrium",
    "support": {
        "issues": "https://github.com/AlveBy/atrium/issues",
        "source": "https://github.com/AlveBy/atrium"
    },
    "keywords": [
        "laravel",
        "admin",
        "cms",
        "bitrix",
        "migration",
        "multisite",
        "i18n"
    ],
    "require": {
        "php": "^8.3",
        "ext-intl": "*",
        "illuminate/support": "^13.0",
        "alveby/atrium": "^0.1"
    },
    "require-dev": {
        "alveby/atrium-brands": "^0.1",
        "alveby/atrium-catalog": "^0.1",
        "alveby/atrium-faq": "^0.1",
        "alveby/atrium-forms": "^0.1",
        "alveby/atrium-news": "^0.1",
        "alveby/atrium-pages": "^0.1",
        "alveby/atrium-reviews": "^0.1",
        "alveby/atrium-stores": "^0.1",
        "orchestra/testbench": "^11.0",
        "phpunit/phpunit": "^12.5"
    },
    "autoload": {
        "psr-4": {
            "Atrium\\Theme\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Atrium\\Theme\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Atrium\\Theme\\ThemeServiceProvider"
            ]
        },
        "branch-alias": {
            "dev-main": "0.1.x-dev"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
